# Gemeinsames Login für die ganze Familie (Basic Auth)
BASIC_AUTH_USER=familie
BASIC_AUTH_PASSWORD=bitte-aendern

# Vercel Blob – wird von Vercel automatisch gesetzt, sobald ein Blob Store
# mit dem Projekt verbunden ist. Für lokale Entwicklung: Token aus dem
# Vercel-Dashboard kopieren (Storage → Blob → .env.local)
BLOB_READ_WRITE_TOKEN=

# Web Push (VAPID). Keys generieren mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com

# Schützt den Cron-Endpunkt /api/check. Beliebiger langer Zufallswert,
# z.B. mit: openssl rand -hex 32
CRON_SECRET=

# Optional: „bis“-Zeiten der 4 Fütterungen (Frühstück, Zmittag, Zvieri, Znacht)
# Standard: 07:00,08:00,17:00,21:00
# FEED_TIMES=07:00,08:00,17:00,21:00
